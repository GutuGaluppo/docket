# --- Database (Neon) -------------------------------------------------------
# Pooled connection string from the Neon dashboard. Local development uses a
# Neon branch too — the serverless driver speaks HTTP, not raw Postgres.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/docket?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Only needed when the deployment URL cannot be inferred (Vercel sets it).
# AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorised redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub → Settings → Developer settings → OAuth Apps.
# Authorisation callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Public ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
