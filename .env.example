# --- Database (Neon) -------------------------------------------------------
# Runtime queries. The POOLED string — the host contains `-pooler`.
# Neon console → Connect → copy with "Connection pooling" left on.
DATABASE_URL="postgresql://user:password@ep-cool-name-a1b2c3d4-pooler.c-2.eu-central-1.aws.neon.tech/docket?sslmode=require&channel_binding=require"

# Migrations only (drizzle-kit). The DIRECT string: character for character the
# same as above with ONLY the six characters `-pooler` removed. Everything else
# stays, including the `c-N` segment — dropping it reaches a different endpoint
# that rejects the role with "password authentication failed". Safest is to
# copy it from the Neon console with pooling toggled off.
#
# The pooled endpoint is PgBouncer in transaction mode and cannot run the
# session-level SET/PREPARE drizzle-kit issues. Neon's Vercel integration sets
# this name for you.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-cool-name-a1b2c3d4.c-2.eu-central-1.aws.neon.tech/docket?sslmode=require&channel_binding=require"

# Optional. A throwaway Neon branch for the tenant-isolation integration test.
# It creates and deletes users, so never point it at real data.
# TEST_DATABASE_URL=""

# --- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Only needed when the deployment URL cannot be inferred (Vercel sets it).
# AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorised redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub → Settings → Developer settings → OAuth Apps.
# Authorisation callback URL: <origin>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Public ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Sentry (opcional) -----------------------------------------------------
# Sem DSN o SDK não inicializa e nada é enviado. Preencha na Vercel quando
# quiser monitoramento de erros ligado.
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Só para upload de source maps no build. Sem ele o passo é pulado.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# --- E-mail (Resend) -------------------------------------------------------
# Sem os dois, os lembretes ficam inertes: o cron ainda roda e relata o que
# encontrou, mas não contata ninguém.
RESEND_API_KEY=""
# Precisa ser um endereço num domínio verificado na Resend.
EMAIL_FROM="Docket <docket@www.docket.click>"

# Protege /api/cron/follow-ups. A Vercel envia este valor como Bearer token.
# Sem ele a rota se recusa a rodar. openssl rand -hex 32
CRON_SECRET=""
